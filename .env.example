# ===== 生产/部署环境变量模板 =====
# 复制为 .env 后填入真实值；.env 已被 .gitignore 排除，严禁入库
# docker compose 会自动读取同目录下的 .env

# JWT 签名密钥（必填，64 位以上随机字符串；未配置时后端启动即失败）
# 生成方式（任选）：
#   PowerShell:  [Convert]::ToBase64String((1..64 | % { Get-Random -Maximum 256 }) -as [byte[]])
#   Linux/macOS: openssl rand -base64 64
APP_JWT_SECRET=

# MySQL root 密码（生产务必修改）
MYSQL_ROOT_PASSWORD=root

# RustFS 对象存储凭据（生产务必修改默认 rustfsadmin/rustfsadmin）
STORAGE_RUSTFS_ACCESS_KEY=rustfsadmin
STORAGE_RUSTFS_SECRET_KEY=rustfsadmin

# 对外暴露的文件访问域名（头像等公开 URL 的前缀）
STORAGE_RUSTFS_PUBLIC_URL=http://localhost:9000
